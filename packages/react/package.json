{
  "name": "@whitechain-commerce/react",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "node ../../apps/dashboard/node_modules/tsx/dist/cli.mjs --test src/*.test.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@whitechain-commerce/core": "workspace:*",
    "@worldcoin/idkit": "4.6.0",
    "viem": "^2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^5"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "import": "./dist/server.js"
      }
    }
  },
  "description": "React checkout components and server helpers for Whitechain Commerce.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sahil-Gulihar/ethglobal-mum.git",
    "directory": "packages/react"
  }
}
