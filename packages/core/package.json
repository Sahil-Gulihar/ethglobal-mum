{
  "name": "@whitechain-commerce/core",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./webhooks": "./src/webhooks.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "viem": "^2"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./webhooks": {
        "types": "./dist/webhooks.d.ts",
        "import": "./dist/webhooks.js"
      }
    }
  },
  "description": "Shared types and protocol helpers for Whitechain Commerce.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sahil-Gulihar/ethglobal-mum.git",
    "directory": "packages/core"
  }
}
