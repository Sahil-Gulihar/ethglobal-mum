# Server RPC for Whitechain Sepolia (chain 1874). Ankr endpoint with your key.
WHITECHAIN_RPC_URL=
# Backend signer: deploys PaymentRouter (owner) and calls registerMerchant. Testnet hot wallet only.
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
# Set after deploy (also written to packages/core/src/deployment.ts)
PAYMENT_ROUTER_ADDRESS=
NEXT_PUBLIC_PAYMENT_ROUTER_ADDRESS=
# Browser RPC for wallet_addEthereumChain (public, no key)
NEXT_PUBLIC_WHITECHAIN_RPC_URL=
DATABASE_URL=postgres://wc:wc@localhost:5433/whitechain_commerce
APP_URL=http://localhost:3000
# World ID (IDKit 4, Proof of Human). With SKIP_WORLD_ID=false, new merchants stay pending
# until they verify on the Setup page. Set SKIP_WORLD_ID=true to activate on signup instead.
SKIP_WORLD_ID=false
WORLD_APP_ID=
WORLD_ACTION=merchant-onboarding
WORLD_RP_ID=
WORLD_RP_SIGNER_ADDRESS=
WORLD_RP_SIGNER_PRIVATE_KEY=
# staging works with the simulator (https://simulator.worldcoin.org); production needs World App.
WORLD_ENVIRONMENT=staging
# Demo store (apps/demo-store)
WC_API_BASE=http://localhost:3000
WC_SECRET_KEY=
WC_WEBHOOK_SECRET=

# 0G Private Computer (verified buyers / human check). ZG_API_KEY (sk-) pays for guest checks;
# signed-in buyers pay with their own 0G account. BUYER_KEY_SECRET encrypts buyers' 0G keys (defaults to CRON_SECRET).
ZG_API_KEY=
# ZG_ROUTER_URL=https://router-api.0g.ai/v1
# ZG_TRUST_MODE=private
# BUYER_KEY_SECRET=
